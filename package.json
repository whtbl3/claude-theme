{
  "name": "velin",
  "displayName": "Velin",
  "description": "Warm, low-contrast dark themes (Velin Dark and Velin Dimmed) built on an 18-color palette, plus a matching style for Markdown Preview Enhanced.",
  "version": "0.7.0",
  "publisher": "whtbl3",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/whtbl3/velin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "color theme",
    "warm",
    "dimmed",
    "markdown",
    "markdown-preview-enhanced"
  ],
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Velin Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/velin-dark-color-theme.json"
      },
      {
        "label": "Velin Dimmed",
        "uiTheme": "vs-dark",
        "path": "./themes/velin-dimmed-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "velin.installMpeStyle",
        "title": "Install Markdown Preview Enhanced Style",
        "category": "Velin"
      }
    ]
  },
  "scripts": {
    "package": "node scripts/build-vsix.js"
  }
}
