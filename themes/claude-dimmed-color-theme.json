{
  "$schema": "vscode://schemas/color-theme",
  "name": "Claude Dimmed",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#e8e6e3",
    "descriptionForeground": "#a8a29e",
    "disabledForeground": "#6b6660",
    "focusBorder": "#d9775780",
