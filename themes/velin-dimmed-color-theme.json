  "tokenColors": [
    {
      "scope": [
        "constant.other.caps",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d98a9a"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a847d",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.DML",
        "keyword.other.DDL",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#ea9a78"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#a8a29e"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a7bd86"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#94c7bb"
      }
    },
    {
      "scope": [
        "support.type.python"
      ],
      "settings": {
        "foreground": "#c6a5c1"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable",
        "variable.other.property",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e8e6e3"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#ea9a78",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.decorator",
