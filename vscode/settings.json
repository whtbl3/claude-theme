  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#7c7368",
            "fontStyle": ""
          }
        },
        {
          "scope": [
            "keyword",
            "storage",
            "storage.type",
            "storage.modifier",
            "keyword.operator.new",
            "keyword.other.DML",
            "keyword.other.DDL",
            "keyword.other.sql"
          ],
          "settings": {
            "foreground": "#ea9a78"
          }
        },
        {
          "scope": [
            "keyword.operator",
            "punctuation"
          ],
          "settings": {
            "foreground": "#a8a29e"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted",
            "string.template",
            "punctuation.definition.string"
          ],
          "settings": {
            "foreground": "#a7bd86"
          }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language",
            "constant.character",
            "constant.other",
            "support.constant"
          ],
          "settings": {
            "foreground": "#e0b07a"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call.generic"
          ],
          "settings": {
            "foreground": "#f0cd96"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class",
            "entity.other.inherited-class"
          ],
          "settings": {
            "foreground": "#87b8ad"
          }
        },
        {
          "scope": [
            "variable",
            "variable.parameter",
            "meta.definition.variable",
            "variable.other.property",
            "support.variable"
          ],
          "settings": {
            "foreground": "#d6bfa0"
          }
        },
        {
          "scope": [
            "variable.language",
            "variable.language.self",
            "variable.language.this"
          ],
          "settings": {
            "foreground": "#ea9a78",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "entity.name.tag",
            "meta.decorator",
            "entity.name.function.decorator"
          ],
          "settings": {
            "foreground": "#ea9a78"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name",
            "support.type.property-name"
          ],
          "settings": {
            "foreground": "#e8a87c"
          }
        },
        {
          "scope": [
            "markup.heading",
            "entity.name.section"
          ],
          "settings": {
            "foreground": "#f4f1ec",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.bold"
          ],
          "settings": {
            "foreground": "#f4f1ec",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.inline.raw",
            "markup.fenced_code"
          ],
          "settings": {
            "foreground": "#e8a87c"
          }
        },
        {
          "scope": [
            "markup.underline.link",
            "string.other.link"
          ],
          "settings": {
            "foreground": "#e8a87c"
          }
        },
        {
          "scope": [
            "markup.quote"
          ],
          "settings": {
            "foreground": "#a8a29e",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.list",
            "punctuation.definition.list.begin"
          ],
          "settings": {
            "foreground": "#d97757"
          }
        },
        {
          "scope": [
            "markup.inserted"
          ],
          "settings": {
            "foreground": "#a7bd86"
          }
        },
        {
          "scope": [
            "markup.deleted"
          ],
          "settings": {
            "foreground": "#e08a78"
          }
        },
        {
          "scope": [
            "invalid"
          ],
          "settings": {
            "foreground": "#e8705a"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "rules": {
        "function": "#f0cd96",
        "method": "#f0cd96",
        "class": "#87b8ad",
        "type": "#87b8ad",
        "enum": "#87b8ad",
        "interface": "#87b8ad",
        "namespace": "#87b8ad",
        "parameter": "#d6bfa0",
        "variable": "#d6bfa0",
        "property": "#d6bfa0",
        "decorator": "#ea9a78",
        "selfParameter": {
          "foreground": "#ea9a78",
          "italic": true
        }
      }
    }
  }
}
